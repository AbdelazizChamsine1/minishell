{
   readline_malloc
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   obj:/*/libreadline.so*
   ...
}
{
   readline_calloc
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:calloc
   obj:/*/libreadline.so*
   ...
}
{
   add_history_leak
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   fun:strdup
   fun:add_history
   ...
}